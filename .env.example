# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (envio de email com relatório)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=Diagnos <no-reply@your-domain.com>
MANAGER_NOTIFICATION_EMAIL=comercial@example.com

# Chave interna (server-only) usada pelo proxy para autenticar chamadas ao backend.
# 32+ caracteres aleatórios. NUNCA expor ao cliente.
INTERNAL_API_KEY=generate-with-openssl-rand-hex-32

# Pipeline de agentes (server-only) - LLM OpenAI-compatible (Command Code / OllamaCloud)
LLM_BASE_URL=https://api.commandcode.ai/provider/v1
LLM_API_KEY=your-llm-api-key
LLM_MODEL=deepseek/deepseek-v4-flash

# Exa (pesquisa de mercado)
EXA_API_KEY=your-exa-api-key

# Vercel Cron (server-only): secret enviado no header Authorization pelo cron do Vercel
# ao chamar /api/analysis-worker. Deve ser igual ao CRON_SECRET configurado no Vercel.
CRON_SECRET=generate-with-openssl-rand-hex-32
