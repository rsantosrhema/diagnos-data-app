# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (envio de email com token)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=Diagnos <no-reply@your-domain.com>
MANAGER_NOTIFICATION_EMAIL=comercial@example.com

# Chave interna (server-only) usada pelo proxy para autenticar chamadas ao backend.
# 32+ caracteres aleatórios. NUNCA expor ao cliente.
INTERNAL_API_KEY=generate-with-openssl-rand-hex-32

# Token master (server-only) para testes. Nunca expira, permite reenvio ilimitado.
# 32+ caracteres. Deixe vazio para desabilitar.
MASTER_TOKEN_VALUE=
# Email do lead de teste vinculado ao token master (default: master@diagnos.test).
MASTER_TOKEN_LEAD_EMAIL=master@diagnos.test
